<div class="card mb-3">
    <div class="card-body">
        <div class="row align-items-end">
            <div class="col-md-4">
                <label class="form-label fw-bold">Start Date:</label>
                <input type="date" class="form-control" @bind="StartDate" @bind:event="oninput" />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-bold">End Date:</label>
                <input type="date" class="form-control" @bind="EndDate" @bind:event="oninput" />
            </div>
            <div class="col-md-4">
                <button class="btn btn-primary me-2" @onclick="ApplyFilter">Apply Filter</button>
                <button class="btn btn-secondary" @onclick="ClearFilter">Clear</button>
            </div>
        </div>
    </div>
</div>

@code {
    private DateTime? StartDate { get; set; }
    private DateTime? EndDate { get; set; }

    [Parameter]
    public EventCallback<DateTime?> OnStartDateChanged { get; set; }

    [Parameter]
    public EventCallback<DateTime?> OnEndDateChanged { get; set; }

    private async Task ApplyFilter()
    {
        await OnStartDateChanged.InvokeAsync(StartDate);
        await OnEndDateChanged.InvokeAsync(EndDate);
    }

    private async Task ClearFilter()
    {
        StartDate = null;
        EndDate = null;
        await OnStartDateChanged.InvokeAsync(null);
        await OnEndDateChanged.InvokeAsync(null);
    }

  
}