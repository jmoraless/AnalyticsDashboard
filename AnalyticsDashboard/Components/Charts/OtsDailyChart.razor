@inject IJSRuntime JS
@inject AnalyticsDashboard.Services.DashboardState DashboardState
@implements IDisposable


<div class="card">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">📈 OTS by Day</h5>
    </div>
    <div class="card-body">
        @if (Data == null)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2">Loading data...</p>
            </div>
        }
        else if (!Data.Any())
        {
            <div class="text-center py-5 text-muted">
                <p>No data available for the selected period</p>
            </div>
        }
        else
        {
            <canvas id="otsDailyChart" style="width:100%; height:400px;"></canvas>
        }
    </div>
</div>

@code {
    [Parameter]
    public List<OtsDailyDto>? Data { get; set; }

    private string ChartId => "otsDailyChart";
    private bool _isDataLoaded = false;

    protected override void OnInitialized()
    {
        // Suscribirse al evento cuando los datos estén listos
        DashboardState.OnDataLoaded += async () => await RenderChartIfDataReady();
    }

    private async Task RenderChartIfDataReady()
    {
        if (Data != null && Data.Any() && !_isDataLoaded)
        {
            _isDataLoaded = true;
            await Task.Delay(100);
            await RenderChart();
        }
    }

    private async Task RenderChart()
    {
        var labels = Data!.Select(d => d.Date.ToString("yyyy-MM-dd")).ToArray();
        var values = Data!.Select(d => d.TotalOts).ToArray();

        Console.WriteLine($"📊 OtsDailyChart - Renderizando: {labels.Length} labels");
        
        await JS.InvokeVoidAsync("chartInterop.renderLineChart", ChartId, "OTS by Day", labels, values, "Total OTS");
    }

    public void Dispose()
    {
        DashboardState.OnDataLoaded -= async () => await RenderChartIfDataReady();
    }
}