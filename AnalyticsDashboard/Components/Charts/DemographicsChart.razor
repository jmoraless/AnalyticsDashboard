@inject IJSRuntime JS

<div class="card">
    <div class="card-header bg-warning text-dark">
        <h5 class="mb-0">@Title</h5>
    </div>
    <div class="card-body">
        @if (Data == null)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-warning" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2">Loading data...</p>
            </div>
        }
        else if (!Data.Any())
        {
            <div class="text-center py-5 text-muted">
                <p>No data available</p>
            </div>
        }
        else
        {
            <canvas id="@ChartId" style="width:100%; height:350px;"></canvas>
        }
    </div>
</div>

@code {
    [Parameter]
    public List<ViewerDemographicDto>? Data { get; set; }

    [Parameter]
    public string Type { get; set; } = "gender";

    private string Title => Type == "gender" ? "👥 Distribution by Gender" : "🎂 Distribution by Age";
    private string ChartId => Type == "gender" ? "genderChart" : "ageChart";
    private bool _isFirstRender = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _isFirstRender = false;
            return;
        }

        if (Data != null && Data.Any())
        {
            await Task.Delay(100);
            await RenderChart();
        }
    }

    private async Task RenderChart()
    {
        List<ViewerDemographicDto> filteredData;
        
        if (Type == "gender")
        {
            filteredData = Data!.GroupBy(d => d.Gender)
                .Select(g => g.First())
                .ToList();
            
            var labels = filteredData.Select(d => d.Gender).ToArray();
            var values = filteredData.Select(d => d.Count).ToArray();
            
            await JS.InvokeVoidAsync("chartInterop.renderPieChart", ChartId, Title, labels, values);
        }
        else
        {
            filteredData = Data!.GroupBy(d => d.AgeGroup)
                .Select(g => g.First())
                .ToList();
            
            var labels = filteredData.Select(d => d.AgeGroup).ToArray();
            var values = filteredData.Select(d => d.Count).ToArray();
            
            await JS.InvokeVoidAsync("chartInterop.renderBarChart", ChartId, Title, labels, values, "Count");
        }
    }

}