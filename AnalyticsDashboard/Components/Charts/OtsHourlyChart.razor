@inject IJSRuntime JS

<div class="card">
    <div class="card-header bg-success text-white">
        <h5 class="mb-0">📊 OTS by Hour</h5>
    </div>
    <div class="card-body">
        @if (Data == null)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-success" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2">Loading data...</p>
            </div>
        }
        else if (!Data.Any())
        {
            <div class="text-center py-5 text-muted">
                <p>No data available</p>
            </div>
        }
        else
        {
            <canvas id="otsHourlyChart" style="width:100%; height:400px;"></canvas>
        }
    </div>
</div>

@code {
    [Parameter]
    public List<OtsHourlyDto>? Data { get; set; }

    private string ChartId => "otsHourlyChart";
    private bool _isFirstRender = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _isFirstRender = false;
            return;
        }

        if (Data != null && Data.Any())
        {
            await Task.Delay(100);
            await RenderChart();
        }
    }

    public async Task RenderChartManually()
    {
        if (Data != null && Data.Any())
        {
            await Task.Delay(100);
            await RenderChart();
        }
    }

    private async Task RenderChart()
    {
        var labels = Data!.Select(d => $"{d.Hour}:00").ToArray();
        var values = Data!.Select(d => d.TotalOts).ToArray();

        await JS.InvokeVoidAsync("chartInterop.renderBarChart", ChartId, "OTS by Hour", labels, values, "Total OTS");
    }
}