@inject IJSRuntime JS

<div class="card">
    <div class="card-header bg-danger text-white">
        <h5 class="mb-0">😊 Sentiment Analysis</h5>
    </div>
    <div class="card-body">
        @if (Data == null)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-danger" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2">Loading data...</p>
            </div>
        }
        else
        {
            <div class="row">
                <div class="col-md-6">
                    <canvas id="sentimentPieChart" style="width:100%; height:300px;"></canvas>
                </div>
                <div class="col-md-6">
                    <div class="text-center">
                        <h3>@Data.AverageSentiment</h3>
                        <div class="progress mt-3">
                            <div class="progress-bar bg-success" role="progressbar" style="width: @(Data.HappyRate)%">
                                Happy @(Data.HappyRate)%
                            </div>
                            <div class="progress-bar bg-secondary" role="progressbar" style="width: @(Data.NeutralRate)%">
                                Neutral @(Data.NeutralRate)%
                            </div>
                            <div class="progress-bar bg-danger" role="progressbar" style="width: @(Data.UnhappyRate)%">
                                Unhappy @(Data.UnhappyRate)%
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public SentimentDto? Data { get; set; }

    private bool _isFirstRender = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _isFirstRender = false;
            return;
        }

        if (Data != null)
        {
            await Task.Delay(100);
            await RenderPieChart();
        }
    }

    private async Task RenderPieChart()
    {
        var labels = new[] { "Very Happy", "Happy", "Neutral", "Unhappy", "Very Unhappy" };
        var values = new[]
        {
            Data!.Breakdown.VeryHappy,
            Data!.Breakdown.Happy,
            Data!.Breakdown.Neutral,
            Data!.Breakdown.Unhappy,
            Data!.Breakdown.VeryUnhappy
        };

        await JS.InvokeVoidAsync("chartInterop.renderPieChart", "sentimentPieChart", "Sentiment Distribution", labels, values);
    }

    
}