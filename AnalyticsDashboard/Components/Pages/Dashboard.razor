@page "/"
@using AnalyticsDashboard.Models
@using AnalyticsDashboard.Services
@inject ApiService ApiService
@inject DashboardState DashboardState

<PageTitle>Analytics Dashboard</PageTitle>

<!-- Diagnóstico -->
<div class="alert alert-info">
    <strong>Diagnóstico:</strong>
    @if (otsDailyData == null)
    {
        <span>Cargando datos...</span>
    }
    else
    {
        <span>✅ Datos cargados! OTS: @otsDailyData.Count registros</span>
    }
</div>

<div class="container-fluid">
    <!-- Filtro de fechas -->
    <div class="row">
        <div class="col-12">
            <DateRangePicker OnStartDateChanged="OnStartDateChanged"
                             OnEndDateChanged="OnEndDateChanged" />
        </div>
    </div>

    <!-- Gráficos -->
    @if (otsDailyData != null && sentimentData != null)
    {
        <div class="row mt-4">
            <div class="col-md-6">
                <OtsDailyChart Data="otsDailyData" />
            </div>
            <div class="col-md-6">
                <SentimentChart Data="sentimentData" />
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-12">
                <ComparisonChart Data="comparisonData" />
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-md-6">
                <DemographicsChart Type="gender" Data="demographicsData" />
            </div>
            <div class="col-md-6">
                <DemographicsChart Type="age" Data="demographicsData" />
            </div>
        </div>

        <div class="row mt-4 mb-4">
            <div class="col-12">
                <OtsHourlyChart Data="otsHourlyData" />
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2">Cargando gráficos...</p>
        </div>
    }
</div>

@code {
    private List<OtsDailyDto>? otsDailyData;
    private List<OtsHourlyDto>? otsHourlyData;
    private List<ComparisonDto>? comparisonData;
    private List<ViewerDemographicDto>? demographicsData;
    private SentimentDto? sentimentData;
    
    private DateTime? startDate;
    private DateTime? endDate;

    protected override async Task OnInitializedAsync()
    {
        await LoadAllData();
    }

    private async Task OnStartDateChanged(DateTime? date)
    {
        startDate = date;
        await LoadAllData();
    }

    private async Task OnEndDateChanged(DateTime? date)
    {
        endDate = date;
        await LoadAllData();
    }

    private async Task LoadAllData()
    {
        var otsDailyTask = ApiService.GetOtsDailyAsync(startDate, endDate);
        var otsHourlyTask = ApiService.GetOtsHourlyAsync(startDate, endDate);
        var comparisonTask = ApiService.GetComparisonAsync(startDate, endDate);
        var demographicsTask = ApiService.GetDemographicsAsync(startDate, endDate);
        var sentimentTask = ApiService.GetSentimentAsync(startDate, endDate);

        await Task.WhenAll(otsDailyTask, otsHourlyTask, comparisonTask, demographicsTask, sentimentTask);

        otsDailyData = await otsDailyTask;
        otsHourlyData = await otsHourlyTask;
        comparisonData = await comparisonTask;
        demographicsData = await demographicsTask;
        sentimentData = await sentimentTask;
        
        StateHasChanged();
        
        // Notificar a los componentes que los datos están listos
        DashboardState.NotifyDataLoaded();
    }
}